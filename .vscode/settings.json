{
    //노무사 교재 회독용 텍스트 파일 설정_S
    "[plaintext]": {
        "editor.fontFamily": "함초롬돋움",
        "editor.fontSize": 13.45,
        "editor.lineHeight": 1.4,
        "editor.fontWeight": "bold",
        "editor.selectionHighlight": false, //단어 강조 비활성
        "editor.occurrencesHighlight": "off", //단어 강조 비활성
        "editor.renderLineHighlight": "all", // "line"이 아닌 "all(줄번호 영역(Gutter)에도 적용)"을 사용하여 테두리 가시성 확보
        //자동완성 비활성_S
        "editor.quickSuggestions": {
            "other": false,
            "comments": false,
            "strings": false
        },
        "editor.suggestOnTriggerCharacters": false,
        "editor.wordBasedSuggestions": "off",
        //자동완성 비활성_E
        "editor.wordWrap": "on",
        "editor.matchBrackets": "never", //괄호 매치 강조 비활성
        "editor.autoIndent": "none", //자동들여쓰기 비활성
        "editor.stickyScroll.enabled": false, //상단 고정 영역 비활성
        "editor.guides.indentation": false //들여쓰기 라인 비활성
    },
    "highlight.regexes": {
        "(?![^《》]*》)('[^']+')" : { //''로 배경 강조(문장)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#FFF900",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "15px 0px 0px 0px"
                }
            ]
        },
        "《[^《》]*》|(〈[^〉]+〉)": { //〈〉로 배경 강조(쟁점, 이슈)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#CCE0FF",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 0px 0px"
                }
            ]
        },
        "《[^《》]*》|(\"[^\"]+\")" : { //""로 배경 강조(법 조문 번호, 학자)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#C39BE1",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 0px 0px"
                }
            ]
        },
        "《[^《》]*》|(‘[^’]+’)" : { //‘’로 배경 강조(문장 내 강조)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "^((?!법령).)*$", //법령 폴더 제외
            "decorations": [
                {
                    "backgroundColor": "#FFF900",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 0px 0px"
                }
            ]
        },
        "《[^《》]*》|(“[^”]+”)" : { //“”로 배경 강조(판례번호/이론 또는 저서 강조)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#FF89FF",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 0px 0px"
                }
            ]
        },
        "《[^《》]*》|(^\\<문제.*)": { //답안의 문제 제목
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "color": "#0000FF"
                }
            ]
        },
       "《[^《》]*》|(<[^>]+>)" : { //<>로 배경 강조
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "^((?!법령).)*$", //법령 폴더 제외
            "decorations": [
                {
                    "backgroundColor": "#E8E8E8",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 0px 0px"
                }
            ]
        },
        "(^\\s*－.*)": { //본문 내용
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "fontWeight": "normal",
                    "color": "#101010" //404040
                }
            ]
        },
        "《[^《》]*》|(Ⅰ\\. |Ⅱ\\. |Ⅲ\\. |Ⅳ\\. |Ⅴ\\. |Ⅵ\\. |Ⅶ\\. |Ⅷ\\. |Ⅸ\\. |Ⅹ\\. |Ⅺ\\. |Ⅻ\\. |XIII\\. |XIV\\. |XV\\. )": { //로마숫자 목차 배경 강조
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#FF0000",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "2px 4px 0px 0px", //Top Right Bottom Left(상, 우, 하, 좌)
                    "isWholeLine": false
                }
            ]
        },
        "《[^《》]*》|(\\  [0-9]+\\. )" : { //일반숫자 목차 배경 강조
            "regexFlags": "gm",
