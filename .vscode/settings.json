{
    //노무사 교재 회독용 텍스트 파일 설정_S
    "[plaintext]": {
        "editor.fontFamily": "함초롬돋움",
        "editor.fontSize": 12.7,
        "editor.lineHeight": 1.65,
        "editor.fontWeight": "bold",
        "editor.selectionHighlight": false, //단어 강조 비활성
        "editor.occurrencesHighlight": "off", //단어 강조 비활성
        "editor.renderLineHighlight": "all", // "line"이 아닌 "all(줄번호 영역(Gutter)에도 적용)"을 사용하여 테두리 가시성 확보
        //자동완성 비활성_S
        "editor.quickSuggestions": {
            "other": false,
            "comments": false,
            "strings": false
        },
        "editor.foldingStrategy": "indentation",
        "editor.suggestOnTriggerCharacters": false,
        "editor.wordBasedSuggestions": "off",
        //자동완성 비활성_E
        "editor.wordWrap": "on",
        "editor.matchBrackets": "never", //괄호 매치 강조 비활성
        "editor.autoIndent": "none", //자동들여쓰기 비활성
        "editor.stickyScroll.enabled": false, //상단 고정 영역 비활성
        "editor.guides.indentation": false, //들여쓰기 라인 비활성
        "editor.wrappingIndent": "none" //자동줄바꿈 시 들여쓰기 비활성
    },
    "highlight.regexes": {
        "(?![^《》]*》)('[^']+')" : { //''로 배경 강조(문장)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#FFFC00",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    //"borderWidth": "15px 0px 0px 0px" //밑줄용
                    "borderWidth": "3px 0px 1px 0px" //전체 형광펜 효과 //Top Right Bottom Left(상, 우, 하, 좌)
                }
            ]
        },
        "《[^《》]*》|(〈[^〉]+〉)": { //〈〉로 배경 강조(쟁점, 이슈)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#CCE0FF",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px"
                }
            ]
        },
        "《[^《》]*》|(\"[^\"]+\")" : { //""로 배경 강조(법 조문 번호, 학자)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#DDB8DE",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px"
                }
            ]
        },
        "《[^《》]*》|(‘[^’]+’)" : { //‘’로 배경 강조(문장 내 강조)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "^((?!관련법령).)*$", //관련법령 폴더 제외
            "decorations": [
                {
                    "backgroundColor": "#DCB406",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px"
                }
            ]
        },
        "《[^《》]*》|(“[^”]+”)" : { //“”로 배경 강조(판례번호/이론 또는 저서 강조)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#FF89FF",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px"
                }
            ]
        },
        "《[^《》]*》|(^\\<문제.*)": { //답안의 문제 제목
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "color": "#0000FF"
                }
            ]
        },
        //"《[^《》]*》|((\\<제\\d+.[^>]+>)|(\\<인사[^>]+>)|(\\<경조[^>]+>)|(\\<보충[>]+>)|(\\<입문[^>]+>))": {
        "《[^《》]*》|<(?:제\\d+|인사.|경조.|보충|입문)[^>]*>" : {
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "^((?!관련법령).)*$",
            "decorations": [
                {
                    "color": "#FF0000"
                }
            ]
        },
        "(^\\s*－.*)(?=★|$)": { //본문 내용(”－”(빼기 아님)로 시작), 별표 제외 //(^\\s*－.*)(?=★|$), (^\\s*－[^★].*)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "fontWeight": "normal",
                    "color": "#101010" //404040
                }
            ]
        },
        "《[^《》]*》|(Ⅰ\\. |Ⅱ\\. |Ⅲ\\. |Ⅳ\\. |Ⅴ\\. |Ⅵ\\. |Ⅶ\\. |Ⅷ\\. |Ⅸ\\. |Ⅹ\\. |Ⅺ\\. |Ⅻ\\. |XIII\\. |XIV\\. |XV\\. )": { //로마숫자 목차 배경 강조
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#FF0000",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 4px 1px 0px",
                    "isWholeLine": false
                }
            ]
        },
        "《[^《》]*》|(\\  [0-9]+\\. )" : { //일반숫자 목차 배경 강조
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "^((?!관련법령).)*$", //관련법령 폴더 제외
            "decorations": [
                {
                    "backgroundColor": "#FFC000", //FFB400
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 2px 1px 4px",
                    "isWholeLine": false
                }
            ]
        },
        "《[^《》]*》|( \\([0-9]+\\) )": { //괄호숫자 목차 배경 강조(양 옆 공백 포함)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#92D050",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 3px 1px 4px",
                    "isWholeLine": false
                }
            ]
        },
        "《[^《》]*》|(\\ [①-⑳]\\ )": { //원숫자 목차 배경 강조
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "^((?!관련법령).)*$", //관련법령 폴더 제외
            "decorations": [
                {
                    "backgroundColor": "#8CDBF8",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 1px 1px 2px",
                    "isWholeLine": false
                }
            ]
        },
        "《[^《》]*》|(첫째,|둘째,|셋째,|넷째,|다섯째,|여섯째,|일곱째,|여덟째,|아홉째,|열째,)": { //문장 내 첫째, 둘째, 셋쩨... 배경 강조
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#8CDBF8",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px",
                    "isWholeLine": false
                }
            ]
        },
        // "《[^《》]*》|(\\[[^\\]]+\\])": { //목차의 법 조문 번호 강조([])
        //     "regexFlags": "gm",
        //     "filterLanguageRegex": "plaintext",
        //     "filterFileRegex": "^((?!관련법령).)*$", //관련법령 폴더 제외
        //     "decorations": [
        //         {
        //             "color": "#0000FF"
        //             //"fontWeight": "normal"
        //         }
        //     ]
        // },
        "《[^《》]*》|(\\ [㉠-㉭]\\ )": { //원자음 목차 배경 강조
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "backgroundColor": "#D5B8EA",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 1px 1px 2px",
                    "isWholeLine": false
                }
            ]
        },
        "(★)": { //별 강조
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "decorations": [
                {
                    "color": "#FF0000",
                    "isWholeLine": false
                }
            ]
        },
        //----------관련법령 적용 시작----------
        "(<[^>]+>)" : { //<>
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "color": "#0000FF",
                    "fontWeight": "normal"
                }
            ]
        },
        "(\\[[^\\]]+\\])": { //대괄호[]
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "fontWeight": "normal"
                }
            ]
        },
        "(\\제\\d+편)": { //편
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#66CCFF",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px",
                    "isWholeLine": false
                }
            ]
        },
        "(\\제\\d+장(?:의\\d+)?)" : { //장(가지포함)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#FF9FA1",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px",
                    "isWholeLine": false
                }
            ]
        },
        "(\\제\\d+절(?:의\\d+)?)" : { //절(가지포함)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#ADE57B",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px",
                    "isWholeLine": false
                }
            ]
        },
        "(\\제\\d+관)": { //관
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#DCB406",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px",
                    "isWholeLine": false
                }
            ]
        },
        "(\\제\\d+조(?:의\\d+)?)" : { //조(가지포함)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#D9E1F2",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px",
                    "isWholeLine": false
                }
            ]
        },
        "(\\ [①-⑳]\\ )": { //항
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#FCE4D6",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 1px 1px 2px",
                    "isWholeLine": false
                }
            ]
        },
        "\\<[^\\<\\>]*\\>|\\[[^\\[\\]]*\\]|(\\ [0-9]+(?:\\의\\d+)?\\. )" : { //호(가지포함, <> [] 내 제외)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#EDEDED",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 1px 1px 1px",
                    "isWholeLine": false
                }
            ]
        },
        "(^\\s*[가-하]\\.)": { //목
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#DDEBF7",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 22px",
                }
            ]
        },
        "(\\ [0-9]+\\) )": { //목 하위(반괄호숫자)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#E2EFDA",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 2px 1px 1px",
                    "isWholeLine": false
                }
            ]
        },
        //본문 내 조문번호 배경 강조
        "(?!다목적댐|제외할단어추가)(?:(?:법|영)\\s+)?(?:(?:제\\d+조(?:의\\d+)*|제\\d+항|제\\d+호(?:의\\d+)*)\\s+(?:본문|단서|전단|후단)|제\\d+조(?:의\\d+)*|제\\d+항|제\\d+호(?:의\\d+)*|(?:가|나|다|라|마|바|사|아|자|차|카|타|파|하)목|별지\\s*제\\d+호(?:의\\d+)*\\s*서식|별표\\s*\\d+(?:의\\d+)*|제\\d+급)(?![^\\[\\n]*\\])": {
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#D9E1F2",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px",
                    "isWholeLine": false
                }
            ]
        },
        //본문 내 조문번호 배경 강조(분리)
        "(?<!^\\s*)(제\\d+편|제\\d+장(?:의\\d+)*|제\\d+절(?:의\\d+)*|제\\d+관)": {
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#D9E1F2",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px",
                    "isWholeLine": false
                }
            ]
        },
        "\\[[^\\[\\]]*\\]|《[^《》]*》|(「[^」]+」)" : { //「」 배경 강조(법률 파일의 참조법률)
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            //"filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#C39BE1",
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px"
                }
            ]
        },
        "\\[[^\\[\\]]*\\]|(대통령령|총리령|고용노동부령|보건복지부령|행정안전부령)": { //법률제목의 "대통령령" [] 안에서는 제외
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "backgroundColor": "#b6ffff", //90f2ff
                    "color": "#000000",
                    "borderStyle": "solid",
                    "borderColor": "#FFFFFF",
                    "borderWidth": "3px 0px 1px 0px",
                    "isWholeLine": false
                }
            ]
        },
        "(^\\s* .*)": { //본문 내용
            "regexFlags": "gm",
            "filterLanguageRegex": "plaintext",
            "filterFileRegex": "관련법령",
            "decorations": [
                {
                    "fontWeight": "normal",
                    "color": "#101010"
                }
            ]
        },
    },
    //----------관련법령 적용 종료----------
    "search.QueryTemplate": "https://search.naver.com/search.naver?query=%SELECTION%", //통합검색
    //노무사 2차 교재 회독용 텍스트 파일 설정_E
}