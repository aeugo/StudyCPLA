{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "[노무사] 교재 들여쓰기",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/SetIndentMainText.ps1",
                "-filePath",
                "${file}"
            ],
            "group": "none",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "[노무사] 법령 들여쓰기",
